node_modules/
npm-debug.log*
__pycache__/
*.pyc

# bun only — reject other package managers' lockfiles.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Cloned child repos are local working trees, not part of this repo's history.
workspace/core/*
!workspace/core/.gitkeep
workspace/external/*
!workspace/external/.gitkeep

# BMAD personal/local files (per-developer, not shared).
_bmad/config.user.toml

.env
.env.local
.DS_Store

# Editor/IDE state.
.idea/
.vscode/
*.iml
# Local editor/tool state.
.zcode/
_bmad-output/**/.memlog.md

# Story 6-2a — local compose overrides (deploy/.env.example is the template).
deploy/.env

# Story 6-2b — Terraform: commit the provider lock files
# (.terraform.lock.hcl), never local state, plans or the provider cache.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# The bootstrap stack's first-apply local backend (infra/README.md).
*_override.tf
*_override.tf.json
