# Story 6-2a — overrides for deploy/compose.yml. Copy to deploy/.env (git
# ignores it). Every value has a LOCAL default in compose.yml; these are
# placeholders, never real secrets — production secrets live in the secrets
# manager (docs/design/DEPLOY.md, story 6-2b).

# The database owner (POSTGRES_PASSWORD; the migrate task connects as it).
WMS_DB_OWNER_PASSWORD=local-owner-password
# The app and auth roles' passwords, applied by `db:provision-roles`.
WMS_APP_PASSWORD=local-app-password
WMS_AUTH_PASSWORD=local-auth-password

# The API's keys (each >= 32 characters where the API checks it).
JWT_SECRET=local-only-jwt-secret-change-me
MFA_ENCRYPTION_KEY=local-only-mfa-encryption-key-change-me-32
DEVICE_ENCRYPTION_KEY=local-only-device-encryption-key-change-me
CARRIER_ENCRYPTION_KEY=local-only-carrier-encryption-key-change-me
CHANNEL_ENCRYPTION_KEY=local-only-channel-encryption-key-change-me

# Where the browser reaches the API, and the web origin the API admits.
WMS_API_BASE_URL=http://localhost:3000/api/v1
WMS_WEB_ORIGIN=http://localhost:3001
# Safari refuses a Secure cookie on http://localhost — set false for Safari only.
COOKIE_SECURE=true
