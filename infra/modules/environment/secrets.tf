# Decision 7 + A5 + A9 + A14: Secrets Manager under wms/<env>/….
#
# GENERATED (Terraform, so they are in state — accepted, A10): the RDS master
# password, the wms_app / wms_auth passwords, the Valkey AUTH token, and the
# URLs built from them. 40 alphanumeric characters, so a URL needs no escaping.
#
# OUT OF BAND (no version here — the operator sets them, so they are never in
# state and a lost state never loses a key): the JWT secret and the encryption
# keys. A task that references one with no value cannot start (fail closed).

resource "random_password" "db_master" {
  length  = 40
  special = false
}

resource "random_password" "db_app" {
  length  = 40
  special = false
}

resource "random_password" "db_auth" {
  length  = 40
  special = false
}

resource "random_password" "valkey_auth" {
  length  = 40
  special = false
}

locals {
  db_host     = aws_db_instance.this.address
  db_endpoint = "${local.db_host}:${local.db_port}/${local.db_name}?sslmode=require"

  generated_secrets = {
    "db-master-password"   = random_password.db_master.result
    "db-app-password"      = random_password.db_app.result
    "db-auth-password"     = random_password.db_auth.result
    "valkey-auth-token"    = random_password.valkey_auth.result
    "database-url"         = "postgres://wms_app:${random_password.db_app.result}@${local.db_endpoint}"
    "database-auth-url"    = "postgres://wms_auth:${random_password.db_auth.result}@${local.db_endpoint}"
    "migrate-database-url" = "postgres://${local.db_owner}:${random_password.db_master.result}@${local.db_endpoint}"
    "valkey-url"           = "rediss://:${random_password.valkey_auth.result}@${aws_elasticache_replication_group.this.primary_endpoint_address}:${local.valkey_port}"
  }

  # Name → what it is. EMAIL_SEAL_KEY is created for 5-1a and referenced by
  # no task yet (A5); EXPO_ACCESS_TOKEN is wired only when push_gateway = expo.
  out_of_band_secrets = {
    "jwt-secret"             = "JWT_SECRET — HS256 session signing, >= 16 characters"
    "mfa-encryption-key"     = "MFA_ENCRYPTION_KEY — >= 32 characters; the API refuses to boot without it; losing it makes every enrolled authenticator unreadable"
    "device-encryption-key"  = "DEVICE_ENCRYPTION_KEY — >= 32 characters, device enrollment"
    "carrier-encryption-key" = "CARRIER_ENCRYPTION_KEY — >= 32 characters; losing it loses every stored carrier credential"
    "channel-encryption-key" = "CHANNEL_ENCRYPTION_KEY — >= 32 characters; losing it loses every stored channel credential"
    "email-seal-key"         = "EMAIL_SEAL_KEY — story 5-1a; not referenced by any task until 5-1a wires it"
    "expo-access-token"      = "EXPO_ACCESS_TOKEN — only read when push_gateway = expo"
  }
}

resource "aws_secretsmanager_secret" "generated" {
  for_each = local.generated_secrets

  name                    = "wms/${var.environment}/${each.key}"
  description             = "WMS ${var.environment}: ${each.key} (generated by Terraform)"
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each = local.generated_secrets

  secret_id     = aws_secretsmanager_secret.generated[each.key].id
  secret_string = each.value
}

resource "aws_secretsmanager_secret" "out_of_band" {
  for_each = local.out_of_band_secrets

  name                    = "wms/${var.environment}/${each.key}"
  description             = "WMS ${var.environment}: ${each.value}. Set out of band (docs/design/DEPLOY.md §AWS); Terraform never holds the value."
  recovery_window_in_days = var.secret_recovery_window_days
}
